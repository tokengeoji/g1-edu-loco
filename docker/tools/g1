#!/usr/bin/env bash
# Author: Codex (IIC)
set -euo pipefail

# The acquisition, replay, dashboard and measurement CLIs all default to ./runs.
cd /workspace
command=${1:-help}
if (($#)); then shift; fi
configure_camera_network() {
  # Camera transport may use a different domain/NIC from Unitree state/locomotion.
  export ROS_DOMAIN_ID=${G1_CAMERA_DOMAIN:-${ROS_DOMAIN_ID:-0}}
  [[ $ROS_DOMAIN_ID =~ ^[0-9]+$ ]] || { echo 'Invalid camera DDS domain' >&2; exit 2; }
  if [[ -n ${G1_CAMERA_IFACE:-} ]]; then
    if [[ ! $G1_CAMERA_IFACE =~ ^[[:alnum:]_.:-]+$ || ! -d /sys/class/net/$G1_CAMERA_IFACE ]]; then
      echo "Unknown camera NIC: $G1_CAMERA_IFACE" >&2
      exit 2
    fi
    export CYCLONEDDS_URI="<CycloneDDS><Domain><General><Interfaces><NetworkInterface name=\"$G1_CAMERA_IFACE\"/></Interfaces></General></Domain></CycloneDDS>"
  fi
}

case "$command" in
  interfaces) exec ip -br -4 addr ;;
  health)
    if [[ ${1:-} == --help || ${1:-} == -h ]]; then
      printf '%s\n' 'jsj-g1-tools 컨테이너 안에서 실행' \
        'g1 health NIC [warn=70] [danger=80] [cold_warn=10] [cold_danger=5]'
      exit 0
    fi
    exec g1_health_monitor "$@"
    ;;
  monitor) exec python3 -m g1stairs.monitoring "$@" ;;
  teleop) exec python3 -m g1_teleop "$@" ;;
  stairs)
    if [[ ${1:-} == live ]]; then configure_camera_network; fi
    exec python3 -m g1stairs.geometry "$@"
    ;;
  camera)
    configure_camera_network
    case "${1:-}" in
      --help|-h|'')
        python3 -m g1stairs.camera --help
        printf '%s\n' '' 'jsj-g1-tools 컨테이너에서 사용할 수 있는 추가 명령' \
          'g1 camera probe-usb' 'g1 camera rviz [--self-test]' 'g1 camera compressed-view TOPIC'
        ;;
      rviz)
        shift
        exec xvfb-run -a -s "-screen 0 1280x800x24 -nolisten tcp +extension GLX" \
          bash /opt/g1-tools/g1stairs/camera/resources/rviz-web.sh "$@"
        ;;
      compressed-view) shift; exec python3 -m g1stairs.camera.compressed_view "$@" ;;
      probe-usb) shift; exec python3 -m g1stairs.camera probe "$@" ;;
      *) exec python3 -m g1stairs.camera "$@" ;;
    esac
    ;;
  help|--help|-h)
    cat <<'HELP'
PC2 호스트에서 컨테이너 셸 열기
  docker exec -it jsj-g1-tools bash

jsj-g1-tools 컨테이너 안에서 실행
  g1 interfaces                       로봇 네트워크 인터페이스 확인
  g1 health NIC [options]             C++ 모터 온도·배터리 모니터 (DDS 도메인 0)
  g1 monitor COMMAND [options]        웹 대시보드·상태 기록
  g1 teleop [options]                 ROS 2 키 배치(i 전진, k 정지). --preview 모의 조작, --live 실기체
  g1 camera COMMAND [options]         D435i 시작(start), 외부 TTY·RViz 연결(remote), 깊이 기록·재생
  g1 stairs calibrate [options]       기록한 깊이와 실측 기준점으로 고정 자세 보정
  g1 stairs live [options]            헤드 깊이로 단높이(cm) 표시, --map으로 관측 평면도 표시
  g1 stairs view [options]            저장된 측정 결과를 같은 터미널 표와 평면도로 확인
  g1 stairs measure [options]         /workspace/runs의 깊이 기록으로 계단 치수 계산
  g1 stairs assess [options]          측정된 면에서 발바닥 전체 지지와 선택한 도달 범위 검사
HELP
    ;;
  *) echo "알 수 없는 명령 '$command'. 컨테이너 안에서 g1 --help로 명령을 확인하세요." >&2; exit 2 ;;
esac
